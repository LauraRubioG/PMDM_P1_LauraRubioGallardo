<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:id="@+id/main"
    android:background="@color/background_arena">

    <!-- Título Principal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_welcome"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="40dp" />

    <!-- Botón 1: Recetas de Café -->
    <Button
        android:id="@+id/btnCoffee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_coffee"
        android:backgroundTint="@color/btn_coffee"
        android:textColor="@color/white"
        android:minHeight="56dp"
        android:layout_marginBottom="16dp" />

    <!-- Botón 2: El Rincón del Matcha -->
    <Button
        android:id="@+id/btnMatcha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_matcha"
        android:backgroundTint="@color/btn_matcha"
        android:textColor="@color/white"
        android:minHeight="56dp"
        android:layout_marginBottom="16dp" />

    <!-- Botón 3: Desayunos Nómadas -->
    <Button
        android:id="@+id/btnBreakfast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_breakfast"
        android:backgroundTint="@color/btn_breakfast"
        android:textColor="@color/white"
        android:minHeight="56dp"
        android:layout_marginBottom="16dp" />

    <!-- Botón 4: Equipaje del Barista -->
    <Button
        android:id="@+id/btnEquipment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_equipment"
        android:backgroundTint="@color/btn_equipment"
        android:textColor="@color/white"
        android:minHeight="56dp"
        android:layout_marginBottom="40dp" />

    <!-- Firma de autoría -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/author_name"
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

</LinearLayout>